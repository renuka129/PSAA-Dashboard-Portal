{
  "_version": "1.89.0",
  "sap.app": {
    "id": "psaaadmin",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "0f07f086-a66e-4a54-a7de-89bfe0c1c17c"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/client-srv/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "psaaadmin.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
  "config": {
    "routerClass": "sap.m.routing.Router",
    "controlAggregation": "pages",
    "controlId": "app",
    "transition": "slide",
    "type": "View",
    "viewType": "XML",
    "path": "psaaadmin.view",
    "async": true,
    "viewPath": "psaaadmin.view"
  },
  "routes": [
    {
      "name": "RouteAdmin",
      "pattern": ":?query:",
      "target": "TargetAdmin"
    },
    {
      "name": "RouteClients",
      "pattern": "clients",
      "target": "TargetClients"
    },
    {
      "name": "RouteEmployees",
      "pattern": "employees",
      "target": "TargetEmployees"
    },
    {
  "name": "RouteProjects",
  "pattern": "projects",
  "target": "TargetProjects"
}
  ],
  "targets": {
    "TargetAdmin": {
      "id": "Admin",
      "name": "Admin"
    },
    "TargetClients": {
      "id": "Clients",
      "name": "Clients"
    },
      "TargetEmployees": {
      "id": "Employees",
     "name": "Employees"
    },
      "TargetProjects": {
      "id": "Projects",
     "name": "Projects"
    }
  }
},
    "rootView": {
      "viewName": "psaaadmin.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
